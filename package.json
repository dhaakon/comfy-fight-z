{
  "name": "comfy-fighter-z-repository",
  "version": "0.1.0",
  "private": true,
  "description": "ComfyUI asset generation, game builder and generated output",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm --prefix build ci",
    "workflows": "node comfyui/tools/prepare-workflows.cjs && node comfyui/tools/prepare-audio-workflows.cjs && node comfyui/tools/prepare-cinematic-workflows.cjs --templates-only",
    "nodes:install": "node comfyui/tools/install-comfy-nodes.cjs",
    "import:assets": "node build/tools/import-assets.cjs",
    "build:assets": "node build/tools/build-assets.cjs",
    "build": "node build/tools/build.cjs",
    "build:release": "node build/tools/build.cjs --strict",
    "build:bundle": "node build/tools/build-bundle.cjs",
    "export:dfz": "node build/tools/export-dfz.cjs",
    "start": "node build/tools/serve.cjs",
    "test": "node --test build/test/*.test.cjs",
    "test:browser": "npm run build && node build/test/browser-smoke.cjs",
    "test:builder": "npm run build && node build/test/builder-browser.cjs",
    "workflows:audio": "node comfyui/tools/prepare-audio-workflows.cjs",
    "workflows:factory": "node comfyui/tools/prepare-factory-workflows.cjs",
    "workflows:demo": "node comfyui/tools/prepare-fictional-demo.cjs",
    "adopt:game": "node build/tools/adopt-game.cjs",
    "merge:assets": "node build/tools/merge-bundles.cjs"
  }
}
