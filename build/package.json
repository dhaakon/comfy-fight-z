{
  "name": "comfy-fighter-z",
  "version": "0.1.0",
  "private": true,
  "description": "Reference-driven cloud ComfyUI asset factory and anime fighting game",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "workflows": "node ../comfyui/tools/prepare-workflows.cjs && node ../comfyui/tools/prepare-audio-workflows.cjs && node ../comfyui/tools/prepare-cinematic-workflows.cjs --templates-only",
    "nodes:install": "node ../comfyui/tools/install-comfy-nodes.cjs",
    "import:assets": "node tools/import-assets.cjs",
    "build:assets": "node tools/build-assets.cjs",
    "build": "node tools/build.cjs",
    "build:release": "node tools/build.cjs --strict",
    "build:bundle": "node tools/build-bundle.cjs",
    "start": "node tools/serve.cjs",
    "test": "node --test test/*.test.cjs",
    "test:browser": "npm run build && node test/browser-smoke.cjs",
    "test:builder": "npm run build && node test/builder-browser.cjs",
    "workflows:audio": "node ../comfyui/tools/prepare-audio-workflows.cjs",
    "workflows:factory": "node ../comfyui/tools/prepare-factory-workflows.cjs",
    "workflows:demo": "node ../comfyui/tools/prepare-fictional-demo.cjs",
    "adopt:game": "node tools/adopt-game.cjs",
    "merge:assets": "node tools/merge-bundles.cjs",
    "export:assets": "node tools/export-assets.cjs",
    "install:game": "node tools/install-game.cjs",
    "smoke:prepare": "node ../comfyui/tools/prepare-smoke-test.cjs",
    "example": "node ../example/run.cjs",
    "example:build": "node ../example/run.cjs",
    "example:prepare": "node ../example/prepare.cjs",
    "example:package": "node ../build/tools/package-example.cjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.9"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
